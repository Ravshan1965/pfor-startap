# Example environment configuration
# Copy this file to .env and fill in your values

# Google Gemini API key (optional — falls back to mock generator if not set)
GEMINI_API_KEY=

# JWT secret key for token signing (optional — auto-generated if not set)
SECRET_KEY=change-me-in-production

# SQLite database URL
DATABASE_URL=sqlite:///./pfor_local.db

# JWT token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
